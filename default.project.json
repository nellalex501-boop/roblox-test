{
  "name": "ColdWarLobby",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Lobby": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "LobbyServer": {
        "$path": "src/server"
      }
    },
