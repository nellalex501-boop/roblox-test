export type Unlock = {
	Default: boolean?,
	Credits: number?,
	Level: number?,
	Event: string?,
}

-- Technical data shown in the showroom (1987 figures).
export type Specs = {
	Weight: string,
	Engine: string,
	Speed: string,
	Range: string,
	Armament: string,
	Crew: string,
	Service: string,
}

export type Unit = {
	Id: string,
	Name: string,
	Category: string,
	Faction: string,
	Role: string,
	Status: string,
	Model: string,
	Crew: number,
	Stats: { Armor: number, Firepower: number, Mobility: number, Cost: number },
	Unlock: Unlock,
	Camo: string?, -- default paint scheme (Units.Camos), FACTORY when nil
