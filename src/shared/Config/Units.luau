-- Placeholder roster: align ids/names with the RTS game's real unit list.
--
-- Model = key of the procedural low-poly model the lobby builds when no
-- asset override exists in ServerStorage.LobbyAssets.Units.<Id>.

export type Unlock = {
	Default: boolean?,
	Credits: number?,
	Level: number?,
	Event: string?,
}

export type Unit = {
	Id: string,
	Name: string,
	Category: string,
	Faction: string,
	Role: string,
	Status: string,
	Model: string,
	Crew: number,
	Stats: { Armor: number, Firepower: number, Mobility: number, Cost: number },
	Unlock: Unlock,
	Camo: string?, -- default paint scheme (Units.Camos), FACTORY when nil
	Description: string,
}

