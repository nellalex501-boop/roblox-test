local TEXT: { [string]: string } = {
	NETWORK = "COMMS FAILURE — TRY AGAIN",
	BAD_RESPONSE = "COMMS FAILURE — TRY AGAIN",
	NO_PROFILE = "COMMANDER FILE STILL LOADING",
	NOT_AT_TERMINAL = "STEP UP TO THE TERMINAL TO QUEUE",
	NOT_AT_GARAGE = "RETURN TO THE GARAGE TO DO THIS",
	INVALID_MODE = "MODE UNAVAILABLE",
	DEPLOYING = "ALREADY DEPLOYING",
	ALREADY_QUEUED = "ALREADY IN THIS QUEUE",
	INVALID_SIZE = "INVALID LOBBY SIZE",
	INVALID_CODE = "ENTER A VALID LOBBY CODE",
	NO_SUCH_LOBBY = "NO LOBBY WITH THAT CODE",
	LOBBY_FULL = "THAT LOBBY IS FULL",
	NOT_HOST = "ONLY THE HOST CAN DO THIS",
	NEED_TWO_PLAYERS = "NEED AT LEAST TWO COMMANDERS",
	IN_PRIVATE_LOBBY = "LEAVE YOUR PRIVATE LOBBY FIRST",
	NOT_IN_LOBBY = "YOU ARE NOT IN A LOBBY",
	TOO_MANY_FOR_SIZE = "TOO MANY COMMANDERS FOR THAT SIZE",
	TOO_MANY_LOBBIES = "ALL PRIVATE CHANNELS BUSY — TRY LATER",
	CODE_TAKEN = "CODE COLLISION — TRY AGAIN",
	INVALID_MAP = "MAP UNAVAILABLE",
	UNKNOWN_MISSION = "UNKNOWN ORDERS",
