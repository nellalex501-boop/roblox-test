	UNAVAILABLE = "NOT AVAILABLE",
	LEVEL_TOO_LOW = "COMMANDER LEVEL TOO LOW",
	NOT_ENOUGH_CREDITS = "NOT ENOUGH CREDITS",
	UNKNOWN_CAMO = "UNKNOWN PAINT SCHEME",
	UNIT_LOCKED = "UNIT NOT IN SERVICE",
	CAMO_LOCKED = "PAINT SCHEME NOT OWNED",
	TITLE_LOCKED = "TITLE NOT EARNED YET",
	INVALID_INSIGNIA = "INSIGNIA UNAVAILABLE",
	INVALID_FACTION = "INVALID ALLEGIANCE",
