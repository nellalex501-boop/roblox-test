	NOT_COMPLETE = "OBJECTIVE NOT COMPLETE",
	NOT_ENOUGH_POINTS = "NOT ENOUGH OPERATION POINTS",
	BAD_TIER = "INVALID REWARD",
	UNKNOWN_UNIT = "UNKNOWN UNIT",
