--!nocheck
-- Test runner: `lune run tests/run.luau [filter]`
-- Builds the place with Rojo, then runs every tests/specs/*.spec.luau.
-- Writes build/test-report.md and build/test-results.json.

local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")

local Scheduler = require("./harness/Scheduler")

local filter = process.args[1]

print("== rojo build")
local build = process.exec("rojo", { "build", "default.project.json", "-o", "build/lobby.rbxl" })
if not build.ok then
	print(build.stderr)
	process.exit(1)
end

local specFiles = {}
for _, name in fs.readDir("tests/specs") do
	if name:match("%.spec%.luau$") and (not filter or name:find(filter, 1, true)) then
		table.insert(specFiles, name)
	end
end
table.sort(specFiles)

local results = {}
local totals = { pass = 0, fail = 0 }

local function newT(record)
	local t = {}
	function t.ok(condition, message)
		table.insert(record.checks, { ok = not not condition, message = message or "check" })
		if not condition then
			record.failed = true
		end
		return condition
	end
	function t.eq(actual, expected, message)
		local ok = actual == expected
		return t.ok(ok, (message or "eq") .. (if ok then "" else (" (expected %s, got %s)"):format(tostring(expected), tostring(actual))))
	end
	function t.le(actual, limit, message)
		local ok = actual ~= nil and actual <= limit
		return t.ok(ok, (message or "le") .. (" (%s <= %s)"):format(tostring(actual), tostring(limit)))
	end
	function t.ge(actual, limit, message)
		local ok = actual ~= nil and actual >= limit
		return t.ok(ok, (message or "ge") .. (" (%s >= %s)"):format(tostring(actual), tostring(limit)))
	end
	function t.metric(name, value)
		record.metrics[name] = value
	end
	function t.log(...)
		local parts = {}
		for i = 1, select("#", ...) do
			table.insert(parts, tostring((select(i, ...))))
		end
		table.insert(record.logs, table.concat(parts, " "))
	end
	function t.noRuntimeErrors(message)
		local errors = Scheduler.errors
		t.ok(#errors == 0, (message or "no runtime errors") .. (if #errors > 0 then (" — %d error(s): %s"):format(#errors, errors[1]) else ""))
	end
	return t
end

for _, file in specFiles do
	print("\n== " .. file)
	local spec = require("./specs/" .. file:gsub("%.luau$", ""))
	local cases = {}
	spec(function(name, fn)
		table.insert(cases, { name = name, fn = fn })
	end)
	for _, case in cases do
		Scheduler.reset()
		local record = { spec = file, name = case.name, checks = {}, metrics = {}, logs = {}, failed = false }
		local t = newT(record)
		local started = os.clock()
		local ok, err = xpcall(case.fn, debug.traceback, t)
		record.seconds = os.clock() - started
		if not ok then
			record.failed = true
			record.error = tostring(err)
		end
		if record.failed then
			totals.fail += 1
		else
			totals.pass += 1
		end
		table.insert(results, record)
		local status = if record.failed then "\27[31mFAIL\27[0m" else "\27[32mPASS\27[0m"
		print(("  %s  %s  (%d checks, %.2fs)"):format(status, case.name, #record.checks, record.seconds))
		for _, check in record.checks do
			if not check.ok then
				print("        ✗ " .. check.message)
			end
		end
		if record.error then
			print("        error: " .. record.error)
		end
	end
end

-- Report
local lines = { "# Test report", "", ("Generated by `lune run tests/run.luau` — %d passed, %d failed."):format(totals.pass, totals.fail), "" }
local currentSpec = nil
for _, record in results do
	if record.spec ~= currentSpec then
		currentSpec = record.spec
		table.insert(lines, "## " .. record.spec)
		table.insert(lines, "")
	end
	table.insert(lines, ("### %s %s"):format(if record.failed then "❌" else "✅", record.name))
	for _, check in record.checks do
		table.insert(lines, ("- %s %s"):format(if check.ok then "✔" else "✘", check.message))
	end
	local metricNames = {}
	for name in record.metrics do
		table.insert(metricNames, name)
	end
	table.sort(metricNames)
	if #metricNames > 0 then
		table.insert(lines, "")
		table.insert(lines, "| metric | value |")
		table.insert(lines, "|---|---|")
		for _, name in metricNames do
			local value = record.metrics[name]
			if type(value) == "number" then
				value = if value == math.floor(value) then tostring(value) else string.format("%.2f", value)
			end
			table.insert(lines, ("| %s | %s |"):format(name, tostring(value)))
		end
	end
	for _, log in record.logs do
		table.insert(lines, "    " .. log)
	end
	if record.error then
		table.insert(lines, "```")
		table.insert(lines, record.error)
		table.insert(lines, "```")
	end
	table.insert(lines, "")
end
fs.writeFile("build/test-report.md", table.concat(lines, "\n"))
fs.writeFile("build/test-results.json", serde.encode("json", results, true))

print(("\n%d passed, %d failed"):format(totals.pass, totals.fail))
process.exit(if totals.fail > 0 then 1 else 0)
